{
  "name": "houston-auto-pros",
  "version": "1.0.0",
  "private": true,
  "description": "Houston Auto Pros website with Cloudflare appointment email delivery",
  "scripts": {
    "build:seo": "python scripts/build_seo.py",
    "test:seo": "python -m unittest discover -s tests -p test_seo.py",
    "audit:seo": "python scripts/audit_static_site.py dist --origin https://houstonautopros.com --production --allow-noindex /404.html --allow-noindex /brand.html --allow-noindex /photography.html --json outputs/seo/audit.json",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy:site": "wrangler deploy -c wrangler.site.jsonc",
    "deploy:domains": "wrangler deploy -c wrangler.redirects.jsonc",
    "test": "node --test tests/*.test.mjs",
    "check": "wrangler types && tsc -p jsconfig.json"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "wrangler": "^4.155.0"
  }
}
